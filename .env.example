# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN (.env.example) - TRONO BOT v2.1.0
# Copia este archivo a '.env' y completa con tus credenciales:
#   cp .env.example .env
# ==============================================================================

# 1. Token de tu bot generado por @BotFather (https://t.me/BotFather)
TELEGRAM_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ12345678

# 2. Credenciales de Telegram API obtenidas en https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# 3. Ruta absoluta en el host para el volumen compartido de datos y multimedia
# Crea la carpeta con: mkdir -p /var/www/trono_bot/telegram_data && chmod 777 /var/www/trono_bot/telegram_data
TELEGRAM_DATA_DIR=/var/www/trono_bot/telegram_data
