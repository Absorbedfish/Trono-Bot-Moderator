# Entorno y credenciales locales (usar .env.example como plantilla)
.env

# Entornos virtuales
venv/
env/
.venv/

# Caches de Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Bases de datos y archivos generados en runtime
*.db
*.db-wal
*.db-shm
angel_guardian.db
trono_historial.db

# Almacenamiento temporal y subidas
IA/static/uploads/*
!IA/static/uploads/.gitkeep
shared_media/

# IDEs y sistemas operativos
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
